# Copy to .env and adjust (.env is git-ignored). Every setting has a default in
# src/relay/config.py; the values below match the local Docker Compose stack.

# Model -> backends routing table (backend URLs and per-backend timeouts live there).
RELAY_CONFIG=config/relay.yaml

# Usage ledger and API keys (PostgreSQL container; host port 5433 so it does not clash
# with a natively installed PostgreSQL on 5432). Local-only development credentials.
RELAY_DATABASE_URL=postgresql://relay:relay@127.0.0.1:5433/relay

# Shared rate-limit state (Redis container).
RELAY_REDIS_URL=redis://127.0.0.1:6379/0

# OpenTelemetry traces to Jaeger (OTLP over HTTP). Remove to turn tracing off.
RELAY_OTEL_ENDPOINT=http://127.0.0.1:4318
